<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.template</groupId>
        <artifactId>java-enterprise-template</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>template-hpc</artifactId>
    <name>High Performance Computing</name>
    <description>Parallel streams, CompletableFuture, virtual threads, concurrent collections</description>

    <properties>
        <jacoco.skip>true</jacoco.skip>
    </properties>

    <!-- Common test dependencies (JUnit, AssertJ, Mockito) are inherited from the parent.
         JMH benchmarks live in examples/systems, not here. -->
    <dependencies>
    </dependencies>

    <!--
        Optional overlay: when this module is compiled with JDK 17 (activation
        range [17,21)), exclude VirtualThreadExamples.java. The root POM is
        already Java 21, so this profile is inactive on the default toolchain.
    -->
    <profiles>
        <profile>
            <id>java17</id>
            <activation>
                <jdk>[17,21)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/VirtualThreadExamples.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
