<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        SpotBugs / Find Security Bugs exclusion filter.
        See: https://spotbugs.readthedocs.io/en/stable/filter.html
    -->

    <!-- Suppress low-confidence findings in generated code -->
    <Match>
        <Source name="~.*Generated.*\.java"/>
    </Match>

    <!-- Exclude JMH-generated benchmark harness code -->
    <Match>
        <Package name="~.*\.jmh_generated"/>
    </Match>

    <!-- Suppress serialization warnings on DTOs (common false positive) -->
    <Match>
        <Bug pattern="SE_BAD_FIELD"/>
        <Class name="~.*Dto"/>
    </Match>

    <!-- SPRING_ENDPOINT is informational, not a defect -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <!-- CRLF_INJECTION_LOGS: false positive with SLF4J parameterized logging -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Package name="~com\.example\.template\..*"/>
    </Match>

    <!-- Example-code style / noise. Security-relevant patterns are NOT in this
         block — they are narrowed to the demo packages that need them below. -->
    <Match>
        <Or>
            <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
            <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
            <Bug pattern="DM_CONVERT_CASE"/>
            <Bug pattern="CNT_ROUGH_CONSTANT_VALUE"/>
            <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
            <Bug pattern="IMPROPER_UNICODE"/>
            <Bug pattern="SBSC_USE_STRINGBUFFER_CONCATENATION"/>
            <Bug pattern="URF_UNREAD_FIELD"/>
        </Or>
        <Package name="~com\.example\.template\..*"/>
    </Match>

    <!-- PREDICTABLE_RANDOM is intentional in Monte Carlo / concurrency demos. -->
    <Match>
        <Bug pattern="PREDICTABLE_RANDOM"/>
        <Or>
            <Package name="~com\.example\.template\.simulation(\..*)?"/>
            <Package name="~com\.example\.template\.hpc(\..*)?"/>
        </Or>
    </Match>

    <!-- Constructor injection stores the collaborator; not a mutable-rep leak. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="com.example.template.testing.service.UserService"/>
    </Match>

    <!-- Mutable demo entities / collections expose internal representation. -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Or>
            <Package name="~com\.example\.template\.simulation(\..*)?"/>
            <Package name="~com\.example\.template\.hpc(\..*)?"/>
            <Package name="~com\.example\.template\.patterns(\..*)?"/>
            <Package name="~com\.example\.template\.database(\..*)?"/>
            <Package name="~com\.example\.template\.restfulapi(\..*)?"/>
        </Or>
    </Match>

    <!-- Demo utilities ignore some return values / nullable map searches. -->
    <Match>
        <Or>
            <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
            <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
        </Or>
        <Or>
            <Package name="~com\.example\.template\.hpc(\..*)?"/>
            <Package name="~com\.example\.template\.patterns(\..*)?"/>
            <Package name="~com\.example\.template\.systems(\..*)?"/>
        </Or>
    </Match>
</FindBugsFilter>
